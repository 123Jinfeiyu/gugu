<Slide style={{ width: 1280, height: 720, background: '#FFFBF6', padding: 60, fontFamily: 'Microsoft YaHei' }}>
    <Box style={{ height: 600, flexDirection: 'column' }}>
        <Box style={{ width: 108, height: 30, borderRadius: 15, border: '1px solid #EA580C', flexDirection: 'row', alignItems: 'center', justifyContent: 'center' }}>
            <Text style={{ fontSize: 15, color: '#EA580C' }}>导入</Text>
        </Box>
        <Text style={{ fontSize: 36, fontWeight: 'bold', color: '#241C17', lineHeight: 1.25, marginTop: 16 }}>先猜一猜：它去哪儿了</Text>
        <Box style={{ width: 1160, height: 1, background: '#EFDCCA', marginTop: 16 }} />

        <Box style={{ flexDirection: 'row', gap: 44, marginTop: 24, height: 430 }}>
            <Box style={{ width: 716, flexDirection: 'column', justifyContent: 'center' }}>
                <Text style={{ fontSize: 52, fontWeight: 'bold', color: '#9A3412', lineHeight: 1.35 }}>早上吃的那口馒头，<br />现在在哪儿？</Text>
                <Text style={{ fontSize: 22, color: '#241C17', lineHeight: 1.6, marginTop: 20 }}>先别急着回答——把你猜的路线画下来，再和咕咕走一遍。</Text>

                <Box style={{ flexDirection: 'row', gap: 18, marginTop: 36 }}>
                    <Box style={{ width: 226, borderTop: '2px solid #EA580C', paddingTop: 14 }}>
                        <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#241C17', lineHeight: 1.4 }}>画在活动手册上</Text>
                        <Text style={{ fontSize: 16, color: '#7C6A5C', lineHeight: 1.6, marginTop: 8 }}>用箭头连出你认为的顺序</Text>
                    </Box>
                    <Box style={{ width: 226, borderTop: '2px solid #EA580C', paddingTop: 14 }}>
                        <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#241C17', lineHeight: 1.4 }}>标出你确定的</Text>
                        <Text style={{ fontSize: 16, color: '#7C6A5C', lineHeight: 1.6, marginTop: 8 }}>写清哪一站你最有把握</Text>
                    </Box>
                    <Box style={{ width: 226, borderTop: '2px solid #EA580C', paddingTop: 14 }}>
                        <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#241C17', lineHeight: 1.4 }}>打一个问号</Text>
                        <Text style={{ fontSize: 16, color: '#7C6A5C', lineHeight: 1.6, marginTop: 8 }}>说不准的地方，等会儿验证</Text>
                    </Box>
                </Box>
            </Box>

            <Box style={{ width: 400, flexDirection: 'column', justifyContent: 'center', alignItems: 'center' }}>
                <Image src='assets/mascot.png' style={{ width: 210, height: 236 }} />
                <Box style={{ width: 400, background: '#F1FAF6', borderLeft: '3px solid #1F8A6B', padding: 16, marginTop: 16, flexDirection: 'column', gap: 8 }}>
                    <Text style={{ fontSize: 13, color: '#1F8A6B', letterSpacing: 1 }}>咕咕说</Text>
                    <Text style={{ fontSize: 16, color: '#241C17', lineHeight: 1.65 }}>我不直接告诉你答案。你先猜，猜错也没关系，等会儿我们一站一站验证。</Text>
                </Box>
            </Box>
        </Box>

        <Box style={{ flexDirection: 'row', justifyContent: 'flex-end', marginTop: 12 }}>
            <Text style={{ fontSize: 14, color: '#A89684' }}>03 / 16</Text>
        </Box>
    </Box>
</Slide>
