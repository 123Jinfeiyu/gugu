<Slide style={{ width: 1280, height: 720, background: '#FFFBF6', padding: 60, fontFamily: 'Microsoft YaHei' }}>
    <Box style={{ height: 600, flexDirection: 'column' }}>
        <Box style={{ width: 108, height: 30, borderRadius: 15, border: '1px solid #EA580C', flexDirection: 'row', alignItems: 'center', justifyContent: 'center' }}>
            <Text style={{ fontSize: 15, color: '#EA580C' }}>第 1 站</Text>
        </Box>
        <Text style={{ fontSize: 36, fontWeight: 'bold', color: '#241C17', lineHeight: 1.25, marginTop: 16 }}>口腔：食物的粉碎车间</Text>
        <Box style={{ width: 1160, height: 1, background: '#EFDCCA', marginTop: 16 }} />

        <Box style={{ flexDirection: 'row', gap: 48, marginTop: 24, height: 430 }}>
            <Box style={{ width: 632, flexDirection: 'column', justifyContent: 'center' }}>
                <Text style={{ fontSize: 22, color: '#9A3412', fontWeight: 'bold', lineHeight: 1.6 }}>这一站只干一件事：把食物变小。</Text>

                <Box style={{ flexDirection: 'row', gap: 16, marginTop: 26, paddingBottom: 16, borderBottom: '1px solid #EFDCCA' }}>
                    <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#241C17', lineHeight: 1.35, width: 84 }}>牙齿</Text>
                    <Text style={{ fontSize: 18, color: '#241C17', lineHeight: 1.6 }}>切、撕、磨，把大块的食物变小</Text>
                </Box>
                <Box style={{ flexDirection: 'row', gap: 16, marginTop: 16, paddingBottom: 16, borderBottom: '1px solid #EFDCCA' }}>
                    <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#241C17', lineHeight: 1.35, width: 84 }}>舌头</Text>
                    <Text style={{ fontSize: 18, color: '#241C17', lineHeight: 1.6 }}>来回翻动，让食物和唾液拌匀</Text>
                </Box>
                <Box style={{ flexDirection: 'row', gap: 16, marginTop: 16 }}>
                    <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#241C17', lineHeight: 1.35, width: 84 }}>唾液</Text>
                    <Text style={{ fontSize: 18, color: '#241C17', lineHeight: 1.6 }}>润湿、粘成一团，并开始分解淀粉</Text>
                </Box>

                <Box style={{ width: 632, background: '#FFF3E6', borderRadius: 12, padding: 20, marginTop: 26, flexDirection: 'column' }}>
                    <Text style={{ fontSize: 15, color: '#EA580C' }}>留给学生的问题</Text>
                    <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#241C17', lineHeight: 1.4, marginTop: 8 }}>馒头嚼久了，为什么会变甜？</Text>
                    <Text style={{ fontSize: 16, color: '#7C6A5C', lineHeight: 1.6, marginTop: 8 }}>先让学生说，再打开咕咕，让它只给线索、不给答案。</Text>
                </Box>
            </Box>

            <Box style={{ width: 480, height: 430, background: '#FFF3E6', borderRadius: 16, flexDirection: 'column', alignItems: 'center', justifyContent: 'center' }}>
                <Image src='assets/st-mouth.png' style={{ width: 300, height: 300 }} />
                <Text style={{ fontSize: 15, color: '#7C6A5C', lineHeight: 1.5, marginTop: 16 }}>口腔：牙齿、舌头、唾液一起工作，食物在这里停留约 20 秒</Text>
            </Box>
        </Box>

        <Box style={{ flexDirection: 'row', justifyContent: 'flex-end', marginTop: 12 }}>
            <Text style={{ fontSize: 14, color: '#A89684' }}>05 / 16</Text>
        </Box>
    </Box>
</Slide>
