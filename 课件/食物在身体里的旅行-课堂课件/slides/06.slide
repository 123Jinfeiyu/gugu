<Slide style={{ width: 1280, height: 720, background: '#FFFBF6', padding: 60, fontFamily: 'Microsoft YaHei' }}>
    <Box style={{ height: 600, flexDirection: 'column' }}>
        <Box style={{ width: 108, height: 30, borderRadius: 15, border: '1px solid #EA580C', flexDirection: 'row', alignItems: 'center', justifyContent: 'center' }}>
            <Text style={{ fontSize: 15, color: '#EA580C' }}>第 2 站</Text>
        </Box>
        <Text style={{ fontSize: 36, fontWeight: 'bold', color: '#241C17', lineHeight: 1.25, marginTop: 16 }}>食道：一根会"挤"的管子</Text>
        <Box style={{ width: 1160, height: 1, background: '#EFDCCA', marginTop: 16 }} />

        <Box style={{ flexDirection: 'row', gap: 48, marginTop: 24, height: 430 }}>
            <Box style={{ width: 480, height: 430, background: '#FFF3E6', borderRadius: 16, flexDirection: 'column', alignItems: 'center', justifyContent: 'center' }}>
                <Image src='assets/st-esophagus.png' style={{ width: 272, height: 256 }} />
                <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10, marginTop: 18 }}>
                    <Box style={{ width: 26, height: 2, background: '#EA580C' }} />
                    <Text style={{ fontSize: 16, color: '#9A3412', fontWeight: 'bold' }}>长约 25 厘米</Text>
                    <Box style={{ width: 26, height: 2, background: '#EA580C' }} />
                </Box>
                <Text style={{ fontSize: 15, color: '#7C6A5C', lineHeight: 1.5, marginTop: 10 }}>从喉咙一直通到胃的入口，内壁是光滑的</Text>
            </Box>

            <Box style={{ width: 632, flexDirection: 'column', justifyContent: 'center' }}>
                <Text style={{ fontSize: 22, color: '#9A3412', fontWeight: 'bold', lineHeight: 1.6 }}>它不是滑梯，是一条会自己收缩的肌肉管道。</Text>

                <Box style={{ flexDirection: 'row', gap: 16, marginTop: 26, paddingBottom: 16, borderBottom: '1px solid #EFDCCA' }}>
                    <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#241C17', lineHeight: 1.35, width: 84 }}>管壁</Text>
                    <Text style={{ fontSize: 18, color: '#241C17', lineHeight: 1.6 }}>一圈一圈的肌肉，从上往下依次收缩</Text>
                </Box>
                <Box style={{ flexDirection: 'row', gap: 16, marginTop: 16, paddingBottom: 16, borderBottom: '1px solid #EFDCCA' }}>
                    <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#241C17', lineHeight: 1.35, width: 84 }}>食团</Text>
                    <Text style={{ fontSize: 18, color: '#241C17', lineHeight: 1.6 }}>被一环一环夹住，像挤牙膏一样往下送</Text>
                </Box>
                <Box style={{ flexDirection: 'row', gap: 16, marginTop: 16 }}>
                    <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#241C17', lineHeight: 1.35, width: 84 }}>时间</Text>
                    <Text style={{ fontSize: 18, color: '#241C17', lineHeight: 1.6 }}>一次吞咽，大约 8 秒到达胃——全程最快的一站</Text>
                </Box>

                <Box style={{ width: 632, background: '#F1FAF6', borderLeft: '3px solid #1F8A6B', padding: 18, marginTop: 24, flexDirection: 'column', gap: 8 }}>
                    <Text style={{ fontSize: 13, color: '#1F8A6B', letterSpacing: 1 }}>咕咕会这样追问</Text>
                    <Text style={{ fontSize: 17, color: '#241C17', lineHeight: 1.65 }}>倒立着喝水，水为什么还能进到胃里？推它的，究竟是重力，还是管壁？</Text>
                </Box>
            </Box>
        </Box>

        <Box style={{ flexDirection: 'row', justifyContent: 'flex-end', marginTop: 12 }}>
            <Text style={{ fontSize: 14, color: '#A89684' }}>06 / 16</Text>
        </Box>
    </Box>
</Slide>
