<Slide style={{ width: 1280, height: 720, background: '#FFFBF6', padding: 60, fontFamily: 'Microsoft YaHei' }}>
    <Box style={{ height: 600, flexDirection: 'column' }}>
        <Box style={{ width: 108, height: 30, borderRadius: 15, border: '1px solid #EA580C', flexDirection: 'row', alignItems: 'center', justifyContent: 'center' }}>
            <Text style={{ fontSize: 15, color: '#EA580C' }}>本课目标</Text>
        </Box>
        <Text style={{ fontSize: 36, fontWeight: 'bold', color: '#241C17', lineHeight: 1.25, marginTop: 16 }}>这节课，我们要回答三个问题</Text>
        <Box style={{ width: 1160, height: 1, background: '#EFDCCA', marginTop: 16 }} />

        <Box style={{ flexDirection: 'row', gap: 44, marginTop: 24, height: 430 }}>
            <Box style={{ width: 780, flexDirection: 'column', justifyContent: 'center' }}>
                <Box style={{ flexDirection: 'row', gap: 18, paddingTop: 22, paddingBottom: 22, borderBottom: '1px solid #EFDCCA' }}>
                    <Text style={{ fontSize: 28, fontWeight: 'bold', color: '#EA580C', lineHeight: 1.2, width: 52 }}>01</Text>
                    <Box style={{ flexDirection: 'column', gap: 10 }}>
                        <Text style={{ fontSize: 24, fontWeight: 'bold', color: '#241C17', lineHeight: 1.35 }}>食物从嘴里进去，最后从哪里出去？</Text>
                        <Text style={{ fontSize: 18, color: '#7C6A5C', lineHeight: 1.6 }}>经过哪些地方，每一处大概待多久。</Text>
                    </Box>
                </Box>
                <Box style={{ flexDirection: 'row', gap: 18, paddingTop: 22, paddingBottom: 22, borderBottom: '1px solid #EFDCCA' }}>
                    <Text style={{ fontSize: 28, fontWeight: 'bold', color: '#EA580C', lineHeight: 1.2, width: 52 }}>02</Text>
                    <Box style={{ flexDirection: 'column', gap: 10 }}>
                        <Text style={{ fontSize: 24, fontWeight: 'bold', color: '#241C17', lineHeight: 1.35 }}>食物没有手推，怎么自己往下走？</Text>
                        <Text style={{ fontSize: 18, color: '#7C6A5C', lineHeight: 1.6 }}>待会儿我们用一条软管，把这件事做出来。</Text>
                    </Box>
                </Box>
                <Box style={{ flexDirection: 'row', gap: 18, paddingTop: 22, paddingBottom: 22 }}>
                    <Text style={{ fontSize: 28, fontWeight: 'bold', color: '#EA580C', lineHeight: 1.2, width: 52 }}>03</Text>
                    <Box style={{ flexDirection: 'column', gap: 10 }}>
                        <Text style={{ fontSize: 24, fontWeight: 'bold', color: '#241C17', lineHeight: 1.35 }}>每一站为什么长成那个样子？</Text>
                        <Text style={{ fontSize: 18, color: '#7C6A5C', lineHeight: 1.6 }}>形状，就是它的工作。</Text>
                    </Box>
                </Box>
            </Box>

            <Box style={{ width: 336, height: 430, background: '#FFEDD5', borderRadius: 16, padding: 26, flexDirection: 'column', justifyContent: 'center' }}>
                <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#9A3412', lineHeight: 1.4 }}>这节课怎么走</Text>
                <Box style={{ flexDirection: 'row', gap: 12, marginTop: 20 }}>
                    <Text style={{ fontSize: 15, color: '#EA580C', width: 56 }}>第一步</Text>
                    <Text style={{ fontSize: 16, color: '#241C17' }}>猜一猜，画下你的想法</Text>
                </Box>
                <Box style={{ flexDirection: 'row', gap: 12, marginTop: 16 }}>
                    <Text style={{ fontSize: 15, color: '#EA580C', width: 56 }}>第二步</Text>
                    <Text style={{ fontSize: 16, color: '#241C17' }}>走一站，看它长什么样</Text>
                </Box>
                <Box style={{ flexDirection: 'row', gap: 12, marginTop: 16 }}>
                    <Text style={{ fontSize: 15, color: '#EA580C', width: 56 }}>第三步</Text>
                    <Text style={{ fontSize: 16, color: '#241C17' }}>做实验，把"推"看见</Text>
                </Box>
                <Box style={{ flexDirection: 'row', gap: 12, marginTop: 16 }}>
                    <Text style={{ fontSize: 15, color: '#EA580C', width: 56 }}>第四步</Text>
                    <Text style={{ fontSize: 16, color: '#241C17' }}>闯五关，检验懂了没有</Text>
                </Box>
                <Box style={{ flexDirection: 'row', gap: 12, marginTop: 24, paddingTop: 18, borderTop: '1px solid #F6D5B0' }}>
                    <Text style={{ fontSize: 16, color: '#7C6A5C', lineHeight: 1.6 }}>四个步骤，对应四张任务单。</Text>
                </Box>
            </Box>
        </Box>

        <Box style={{ flexDirection: 'row', justifyContent: 'flex-end', marginTop: 12 }}>
            <Text style={{ fontSize: 14, color: '#A89684' }}>02 / 16</Text>
        </Box>
    </Box>
</Slide>
